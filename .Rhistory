library(tplyr)
knitr::opts_chunk$set(echo = TRUE)
result <- listings |>
dplyr::group_by(host_id) |>
dplyr::summarize(host_listings = dplyr::n()) |>
dplyr::left_join(listings, by = "host_id") |>
dplyr::summarize(
A1 = sum(host_listings >= 10) / host_listings[host_listings >= 10] * 0 +
dplyr::n(),
A2 = sum(city == "Chicago" & host_listings >= 10) /
sum(city == "Chicago") * 100
)
